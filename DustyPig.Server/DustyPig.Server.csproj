<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>Latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591,1579,CS1573,IDE0090</NoWarn>

		<!-- Leave the revision as zero, it will be set by github actions -->
		<Version>3.5.0.0</Version>
		<UserSecretsId>ad457da4-3875-453c-9c70-70fa31ad9064</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

	</PropertyGroup>


	<ItemGroup>
		<None Include="..\.editorconfig" Link=".editorconfig" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.1" />
		<PackageReference Include="Aspire.Seq" Version="13.6.1" />
		<PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
		<PackageReference Include="DustyPig.API" Version="3.7.1.319" />
		<PackageReference Include="DustyPig.Firebase.Auth" Version="3.1.1.26" />
		<PackageReference Include="DustyPig.SimpleDownloader" Version="4.0.0.22" />
		<PackageReference Include="DustyPig.Timers" Version="2.0.0.8" />
		<PackageReference Include="DustyPig.TMDB" Version="4.0.0.49" />
		<PackageReference Include="FirebaseAdmin" Version="3.7.0" />
		<PackageReference Include="Google.Cloud.Firestore" Version="4.5.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="OpenTelemetry.Api" Version="1.20.0" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
		<PackageReference Include="SkiaSharp" Version="4.153.1" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.0" />
	</ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\DustyPig.ServiceDefaults\DustyPig.ServiceDefaults.csproj" />
	</ItemGroup>

</Project>